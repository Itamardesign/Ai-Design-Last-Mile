{
  "manifest_version": 3,
  "name": "Meraki Design Inspector",
  "version": "0.1.0",
  "description": "Inspect, edit and hand off the design of any website: select an element, tune it visually, check accessibility, copy design-system-ready CSS.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Meraki Design Inspector",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "identity",
    "declarativeNetRequestWithHostAccess"
  ],
  "oauth2": {
    "client_id": "REPLACE_ME.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },
  "host_permissions": ["<all_urls>"],
  "commands": {
    "toggle-inspector": {
      "suggested_key": { "default": "Alt+Shift+D", "mac": "Alt+Shift+D" },
      "description": "Toggle the design inspector on this page"
    }
  }
}
