{
  "name": "@merakimind/design-inspector",
  "version": "0.1.0",
  "description": "A live, in-browser design inspection and handoff tool: select any element, edit it visually, and export design-system-ready CSS + instructions.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./detect/loadStaticConfig.node": {
      "types": "./dist/detect/loadStaticConfig.node.d.ts",
      "default": "./dist/detect/loadStaticConfig.node.js"
    },
    "./design-tools.css": "./dist/design-tools.css"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "tsconfig.json",
    "README.md",
    "extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Itamardesign/Ai-Design-Last-Mile.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && node scripts/gen-styles.mjs && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prepare": "node scripts/prepare.mjs",
    "build:extension": "node extension/build.mjs",
    "dev:extension": "node extension/build.mjs --watch",
    "typecheck:extension": "tsc -p extension/tsconfig.json",
    "pack:extension": "node extension/build.mjs && node extension/zip.mjs",
    "test:extension": "node extension/build.mjs && node extension/test/tokens.test.mjs && node extension/test/notes.test.mjs && node extension/test/background.test.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "typescript": "~5.8.2"
  },
  "keywords": [
    "design-system",
    "devtools",
    "inspector",
    "handoff",
    "react"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": {
    "access": "public"
  }
}
